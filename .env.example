# 제출용 로컬 Compose 예시다. 실제 팀 DB·API key·관리자 UUID는 절대 넣지 않는다.
# 개인 환경에서는 이 파일을 복사한 뒤 승인된 비밀 저장소에서 값을 주입한다.
POSTGRES_DB=Team4_Proj
POSTGRES_USER=ai_mafia_app
POSTGRES_PASSWORD=local-development-only-change-before-use

# 기존 통합 실행과 같은 포트만 사용한다. DB·Redis와 보조 MCP는 호스트에 공개하지 않는다.
BACKEND_PORT=18000
MCP_PORT=18100
FRONTEND_PORT=18501

APP_ENV=development
LLM_PROVIDER=dummy
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=8192
ADMIN_USER_IDS=
SPEECH_ANALYSIS_ENABLED=false

# 제출본에는 실제 key 대신 빈 값을 둔다. dummy provider에서는 외부 API를 호출하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
